<?xml version="1.0" encoding="utf-8"?>
<diff>

    <replace sel="//cue[@name='AddAgent']/actions/do_for_each/do_else[create_cue_actor/select/@tags='tag.agent']">
        <do_else>
            <set_value name="$DrJeleAgentGender" exact="if global.$DrJeleDiplomacyAgentGender? then global.$DrJeleDiplomacyAgentGender else (if global.$DrJeleDiplomacyConfig? then global.$DrJeleDiplomacyConfig.$AgentGender else 0)"/>
            <set_value name="$DrJeleAgentCharacter" exact="null"/>
            <do_if value="$DrJeleAgentGender gt 0">
                <set_value name="$DrJeleAgentCharacters" exact="@global.$DrJeleDiplomacyConfig.$AgentCharacters.{'$' + $AgentActorOwner.id}"/>
                <do_if value="$DrJeleAgentCharacters">
                    <set_value name="$DrJeleAgentCharacter" exact="$DrJeleAgentCharacters.{$DrJeleAgentGender}" comment="the table lists female first, so the option value doubles as the index"/>
                </do_if>
            </do_if>

            <do_if value="$DrJeleAgentCharacter">
                <create_cue_actor name="$AgentActor" cue="AgentsActivated" ref="$DrJeleAgentCharacter" seed="this.$seed">
                    <owner exact="$AgentActorOwner"/>
                </create_cue_actor>
            </do_if>
            <do_else>
                <create_cue_actor name="$AgentActor" cue="AgentsActivated" seed="this.$seed">
                    <select tags="tag.agent" faction="$AgentActorOwner"/>
                    <owner exact="$AgentActorOwner"/>
                </create_cue_actor>
            </do_else>
            <signal_cue_instantly cue="AgentCreated" param="$AgentActor"/>
        </do_else>
    </replace>

</diff>
