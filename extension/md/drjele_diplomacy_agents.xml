<?xml version="1.0" encoding="utf-8"?>
<mdscript name="DrJele_DiplomacyAgents" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
    <cues>

        <cue name="Configuration" instantiate="true" namespace="static" version="1">
            <conditions>
                <event_cue_signalled cue="md.Setup.Start"/>
            </conditions>
            <actions>
                <set_value name="$XpFactor" exact="1" comment="multiplies the experience an agent earns per action; 1 is vanilla"/>
                <set_value name="$InjuredXpPercent" exact="0" comment="percent of a no-risk experience roll given to an agent that comes back injured; 0 is vanilla, which gives nothing"/>
                <set_value name="$RiskPercent" exact="100" comment="scales the injury and death chances of a failed risky action; 100 is vanilla, 0 makes agents indestructible"/>
                <set_value name="$AgentsCanDie" exact="1" comment="0 caps the worst outcome of a risky action at an injury; 1 is vanilla, where an agent can also be killed"/>
                <set_value name="$AgentGender" exact="0" comment="0 any, 1 female only, 2 male only - applies to agents spawned from now on"/>

                <set_value name="$AgentCharacters" exact="table[]"/>
                <set_value name="$AgentCharacters.$argon" exact="['agent_argon_female',     'agent_argon_male']"/>
                <set_value name="$AgentCharacters.$antigone" exact="['agent_antigone_female',  'agent_antigone_male']"/>
                <set_value name="$AgentCharacters.$hatikvah" exact="['agent_hatikvah_female',  'agent_hatikvah_male']"/>
                <set_value name="$AgentCharacters.$loanshark" exact="['agent_loansharks_female','agent_loansharks_male']"/>
                <set_value name="$AgentCharacters.$scavenger" exact="['agent_scavenger_female', 'agent_scavenger_male']"/>
                <set_value name="$AgentCharacters.$split" exact="['agent_split_female',     'agent_split_male']"/>
                <set_value name="$AgentCharacters.$freesplit" exact="['agent_freesplit_female', 'agent_freesplit_male']"/>
                <set_value name="$AgentCharacters.$court" exact="['agent_court_female',     'agent_court_male']"/>
                <set_value name="$AgentCharacters.$pioneers" exact="['agent_pioneers_female',  'agent_pioneers_male']"/>
                <set_value name="$AgentCharacters.$terran" exact="['agent_terran_female',    'agent_terran_male']"/>
                <set_value name="$AgentCharacters.$yaki" exact="['agent_yaki_female',      'agent_yaki_male']"/>

                <set_value name="$AgentCharacters.$kaori" exact="['drjele_agent_kaori_female',      'agent_kaori_arg']"/>
                <set_value name="$AgentCharacters.$teladi" exact="['drjele_agent_teladi_female',     'drjele_agent_teladi_male']"/>
                <set_value name="$AgentCharacters.$ministry" exact="['drjele_agent_ministry_female',   'drjele_agent_ministry_male']"/>
                <set_value name="$AgentCharacters.$scaleplate" exact="['drjele_agent_scaleplate_female', 'drjele_agent_scaleplate_male']"/>

                <set_value name="global.$DrJeleDiplomacyConfig" exact="table[$XpFactor         = $XpFactor,
                                                                    $InjuredXpPercent = $InjuredXpPercent,
                                                                    $RiskPercent      = $RiskPercent,
                                                                    $AgentsCanDie     = $AgentsCanDie,
                                                                    $AgentGender      = $AgentGender,
                                                                    $AgentCharacters  = $AgentCharacters]"/>
            </actions>
        </cue>

    </cues>
</mdscript>
